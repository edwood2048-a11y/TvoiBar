# 'postgres' для работы с Supabase/Render, 'json' для локальной разработки
DATABASE_MODE=json

# Используется только если DATABASE_MODE=postgres
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

TELEGRAM_BOT_TOKEN=your_token_here
CORS_ORIGINS=https://your_frontend_url_here,http://localhost:3000